<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Frontend Interview Prep — Master Deck</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a0e14; --bar:#0f141d; --bar-2:#161d29; --border:#26303f;
    --text:#e7eef5; --muted:#8497aa; --faint:#5c6e80; --accent:#F3BA2F;
    --mono:'JetBrains Mono',ui-monospace,monospace;
    --disp:'Space Grotesk',system-ui,sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{background:var(--bg);color:var(--text);font-family:var(--disp);display:flex;overflow:hidden}

  /* ---------- topic rail ---------- */
  .rail{flex:none;width:210px;display:flex;flex-direction:column;min-height:0;
    background:linear-gradient(180deg,var(--bar),var(--bar-2));border-right:1px solid var(--border);
    transition:width .18s ease}
  .railhead{flex:none;height:44px;display:flex;align-items:center;gap:8px;padding:0 8px 0 14px;
    border-bottom:1px solid var(--border)}
  .railhead .mark{flex:1;font-weight:700;font-size:15px;letter-spacing:-.02em;white-space:nowrap;overflow:hidden}
  .railhead .mark b{color:var(--accent)}
  #railToggle{flex:none;width:26px;height:26px;background:transparent;border:1px solid var(--border);
    border-radius:7px;color:var(--muted);font-size:13px;line-height:1;cursor:pointer;transition:.15s}
  #railToggle:hover{color:var(--text);border-color:var(--accent)}

  .jumpbtn{flex:none;display:flex;align-items:center;gap:8px;height:30px;margin:8px 10px 6px;
    width:calc(100% - 20px);padding:0 10px;background:var(--bg);border:1px solid var(--border);
    border-radius:8px;color:var(--faint);font-family:var(--mono);font-size:11px;cursor:pointer;transition:.15s}
  .jumpbtn:hover{border-color:var(--accent);color:var(--text)}
  .jumpbtn kbd{margin-left:auto;font-family:var(--mono);font-size:10px;background:var(--bar-2);
    border:1px solid var(--border);border-radius:4px;padding:1px 5px;color:var(--muted)}

  .railnav{flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column;gap:2px;padding:4px 8px 14px;
    scrollbar-width:thin;scrollbar-color:var(--border) transparent}
  .railnav::-webkit-scrollbar{width:6px}
  .railnav::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

  .grp-label{flex:none;font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--faint);padding:10px 6px 3px;user-select:none;white-space:nowrap}
  .grp-label:first-child{padding-top:2px}

  .rail-item{flex:none;display:flex;align-items:center;gap:9px;width:100%;min-height:25px;
    padding:4px 10px;text-align:left;background:transparent;border:1px solid transparent;border-radius:8px;
    color:var(--muted);font-family:var(--mono);font-size:11.5px;font-weight:600;cursor:pointer;
    white-space:nowrap;overflow:hidden;transition:.15s}
  .rail-item:hover{background:rgba(255,255,255,.05);color:var(--text)}
  .rail-item.on{background:var(--accent);border-color:var(--accent);color:#08110f}
  .rail-item .n{flex:none;width:15px;font-size:9.5px;color:var(--faint)}
  .rail-item.on .n{color:#08110f;opacity:.65}

  /* ---------- collapsed rail ---------- */
  .rail.collapsed{width:48px}
  .rail.collapsed .railhead{padding:0;justify-content:center}
  .rail.collapsed .mark{display:none}
  .rail.collapsed .jumpbtn{justify-content:center;margin:8px 8px 6px;width:calc(100% - 16px);padding:0}
  .rail.collapsed .jumpbtn .jt,.rail.collapsed .jumpbtn kbd{display:none}
  .rail.collapsed .jumpbtn::after{content:"⌕";font-size:14px;color:var(--muted)}
  .rail.collapsed .rail-item{justify-content:center;padding:4px 0;gap:0}
  .rail.collapsed .rail-item .lbl{display:none}
  .rail.collapsed .rail-item .n{width:auto}
  /* group labels become hairlines so the grouping survives collapse */
  .rail.collapsed .grp-label{height:1px;padding:0;margin:6px 8px;background:var(--border);
    text-indent:-9999px;overflow:hidden}
  .rail.collapsed .grp-label:first-child{display:none}

  /* ---------- stage ---------- */
  .stage{flex:1;min-width:0;position:relative;background:var(--bg)}
  iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:none;background:var(--bg)}
  iframe.on{display:block}
  .loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--faint);
    font-family:var(--mono);font-size:13px}

  /* ---------- ⌘K palette ---------- */
  .palette{position:fixed;inset:0;z-index:100;display:flex;justify-content:center;align-items:flex-start;
    padding-top:14vh;background:rgba(4,7,11,.62)}
  .palette[hidden]{display:none}
  .pbox{width:min(560px,92vw);max-height:70vh;display:flex;flex-direction:column;overflow:hidden;
    background:var(--bar-2);border:1px solid var(--border);border-radius:14px;box-shadow:0 24px 60px rgba(0,0,0,.55)}
  .pbox input{width:100%;padding:15px 18px;border:0;border-bottom:1px solid var(--border);outline:0;
    background:transparent;color:var(--text);font-family:var(--disp);font-size:16px}
  .pbox input::placeholder{color:var(--faint)}
  .plist{list-style:none;overflow-y:auto;padding:6px}
  .pitem{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;cursor:pointer;
    color:var(--muted);font-size:13.5px}
  .pitem .pn{font-family:var(--mono);font-size:10px;color:var(--faint)}
  .pitem .pg{margin-left:auto;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;
    text-transform:uppercase;color:var(--faint)}
  .pitem.sel{background:var(--accent);color:#08110f}
  .pitem.sel .pn,.pitem.sel .pg{color:#08110f;opacity:.7}
  .pempty{padding:18px;text-align:center;color:var(--faint);font-family:var(--mono);font-size:12.5px}

  /* ---------- full-text search results ---------- */
  .pbox{max-height:76vh}
  .pgroup{padding:11px 12px 4px;font-family:var(--mono);font-size:9.5px;letter-spacing:.13em;
    text-transform:uppercase;color:var(--faint);user-select:none;pointer-events:none}
  .plist .pgroup:first-child{padding-top:4px}
  .pitem .ptitle{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pitem.two{flex-direction:column;align-items:stretch;gap:3px;padding:8px 12px 9px}
  .pitem .prow{display:flex;align-items:center;gap:10px;min-width:0;flex:1}
  .psnip{font-size:12px;line-height:1.45;color:var(--faint);padding-left:25px;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .pitem b{color:var(--accent);font-weight:700}
  .pitem.sel .psnip{color:rgba(8,17,15,.75)}
  .pitem.sel b{color:#08110f;background:rgba(255,255,255,.45);border-radius:3px}

  /* ---------- mobile: rail becomes a drawer ---------- */
  .railbtn{display:none}
  .backdrop{display:none}
  @media(max-width:760px){
    .rail{position:fixed;top:0;bottom:0;left:0;z-index:60;width:230px;transform:translateX(-100%);
      transition:transform .22s ease}
    .rail.collapsed{width:230px}
    .rail.collapsed .mark,.rail.collapsed .rail-item .lbl,.rail.collapsed .jumpbtn .jt,
    .rail.collapsed .jumpbtn kbd{display:revert}
    .rail.collapsed .railhead{padding:0 8px 0 14px;justify-content:flex-start}
    .rail.collapsed .rail-item{justify-content:flex-start;padding:4px 10px;gap:9px}
    .rail.collapsed .jumpbtn{justify-content:flex-start;padding:0 10px}
    .rail.collapsed .jumpbtn::after{content:none}
    .rail.collapsed .grp-label{height:auto;padding:10px 6px 3px;margin:0;background:none;text-indent:0}
    .rail.open{transform:none}
    #railToggle{display:none}
    .railbtn{display:flex;align-items:center;justify-content:center;position:fixed;top:12px;left:12px;z-index:70;
      width:42px;height:42px;border:none;border-radius:11px;background:var(--accent);color:#08110f;
      font-family:var(--mono);font-size:19px;cursor:pointer}
    .backdrop{position:fixed;inset:0;z-index:55;background:rgba(0,0,0,.5)}
    .backdrop.open{display:block}
  }
</style>
</head>
<body>
  <button class="railbtn" id="railBtn" aria-label="Show topics">≡</button>
  <div class="backdrop" id="backdrop"></div>

  <aside class="rail" id="rail">
    <div class="railhead">
      <span class="mark">FE<b>·</b>Prep</span>
      <button id="railToggle" aria-label="Collapse topic list">‹</button>
    </div>
    <button class="jumpbtn" id="jumpBtn"><span class="jt">Jump to topic</span><kbd id="kbdHint">⌘K</kbd></button>
    <nav class="railnav" id="tabs" role="tablist" aria-orientation="vertical"></nav>
  </aside>

  <div class="stage" id="stage">
    <div class="loading" id="loading">loading…</div>
  </div>

  <div class="palette" id="palette" hidden>
    <div class="pbox" role="dialog" aria-label="Jump to topic">
      <input id="paletteInput" type="text" autocomplete="off" spellcheck="false"
             placeholder="Search every guide — try “hydration”, “CLS”, “tree shaking”…">
      <ul class="plist" id="paletteList"></ul>
    </div>
  </div>

  <!-- injected into every guide iframe by show(); a <template> keeps the inner
       <script> inert here and needs no escaping -->
  <template id="fe-receiver">
<style>
  mark.fe-hit{background:rgba(243,186,47,.28);color:inherit;border-radius:3px;padding:0 1px}
  mark.fe-hit.cur{background:#F3BA2F;color:#08110f;box-shadow:0 0 0 2px rgba(243,186,47,.45)}
  #fe-find-bar{position:fixed;right:18px;bottom:18px;z-index:9999;display:flex;align-items:center;gap:9px;
    padding:8px 10px 8px 14px;border-radius:11px;background:#161d29;border:1px solid #26303f;
    box-shadow:0 12px 34px rgba(0,0,0,.5);font-family:'JetBrains Mono',ui-monospace,monospace;
    font-size:12px;color:#e7eef5;max-width:min(360px,90vw)}
  #fe-find-bar .feq{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#F3BA2F}
  #fe-find-bar .fec{color:#8497aa;font-variant-numeric:tabular-nums;white-space:nowrap}
  #fe-find-bar button{flex:none;width:24px;height:24px;display:flex;align-items:center;justify-content:center;
    background:transparent;border:1px solid #26303f;border-radius:7px;color:#8497aa;cursor:pointer;
    font-family:inherit;font-size:12px;line-height:1;padding:0}
  #fe-find-bar button:hover{color:#e7eef5;border-color:#F3BA2F}
  @media(max-width:760px){#fe-find-bar{right:10px;bottom:10px}}
</style>
<script id="fe-prep-find">
(function(){
  /* MUST stay byte-identical to BLOCK_SEL in the parent, or `ord` misaligns */
  var SEL = 'h2, h3, p, li, td, pre, blockquote';
  var hits = [], cur = -1, bar = null;

  function root(){ return document.querySelector('main') || document.body; }
  function norm(s){ return (s || '').replace(/\s+/g, ' ').trim().toLowerCase(); }
  function blocks(){
    var r = root(); if(!r) return [];
    return [].slice.call(r.querySelectorAll(SEL)).filter(function(el){
      return !(el.closest && el.closest('#bank'));
    });
  }
  function escRe(s){ return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
  function into(el, smooth){
    if(!el) return;
    /* the guides set html{scroll-behavior:smooth}, so 'auto' still animates and
       each re-application restarts the animation. 'instant' is the only override. */
    try{ el.scrollIntoView({block:'center', behavior: smooth ? 'smooth' : 'instant'}); }
    catch(e){ el.scrollIntoView(); }
  }
  /* A goto usually arrives before the guide has finished loading: webfonts then
     land, layout shifts, and the browser puts us back at the top. Re-apply the
     scroll on those two beats instead of animating into a moving target. */
  function land(el){
    if(!el) return;
    into(el, false);
    requestAnimationFrame(function(){ into(el, false); });
    if(document.fonts && document.fonts.ready){
      document.fonts.ready.then(function(){ into(el, false); });
    }
    if(document.readyState !== 'complete'){
      window.addEventListener('load', function(){ into(el, false); }, {once:true});
    }
  }

  /* unwrap every <mark> and stitch the text nodes back together */
  function clearMarks(){
    for(var i=0;i<hits.length;i++){
      var m = hits[i], p = m.parentNode;
      if(!p) continue;
      p.replaceChild(document.createTextNode(m.textContent), m);
      p.normalize();
    }
    hits = []; cur = -1;
  }
  function closeBar(){ clearMarks(); if(bar){ bar.remove(); bar = null; } }

  /* Range.surroundContents keeps existing listeners + observer targets alive.
     innerHTML would silently break the qcard toggles and the scroll-spy. */
  function highlight(terms){
    var r = root(); if(!r || !terms || !terms.length) return;
    /* one alternation, longest first, so overlapping terms never nest marks */
    var re = new RegExp('(' + terms.slice().sort(function(a,b){ return b.length - a.length; })
      .map(escRe).join('|') + ')', 'gi');
    var walker = document.createTreeWalker(r, NodeFilter.SHOW_TEXT, {
      acceptNode: function(n){
        if(!n.nodeValue || !n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
        var p = n.parentNode;
        if(!p || /^(SCRIPT|STYLE|NOSCRIPT|TEXTAREA|MARK)$/.test(p.nodeName)) return NodeFilter.FILTER_REJECT;
        if(p.closest && (p.closest('nav.side') || p.closest('#fe-find-bar'))) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    var texts = [], n;
    while((n = walker.nextNode())) texts.push(n);
    for(var i=0;i<texts.length;i++){
      var node = texts[i], s = node.nodeValue, spans = [], m;
      re.lastIndex = 0;
      while((m = re.exec(s))){
        if(!m[0].length){ re.lastIndex++; continue; }
        spans.push([m.index, m.index + m[0].length]);
      }
      /* back to front: surrounding splits the node, so earlier offsets stay valid */
      for(var j=spans.length-1;j>=0;j--){
        try{
          var rg = document.createRange();
          rg.setStart(node, spans[j][0]);
          rg.setEnd(node, spans[j][1]);
          var mk = document.createElement('mark');
          mk.className = 'fe-hit';
          rg.surroundContents(mk);
          hits.push(mk);
        }catch(e){}
      }
    }
    hits.sort(function(a,b){
      return (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING) ? -1 : 1;
    });
  }

  function ensureBar(q){
    if(!bar){
      bar = document.createElement('div');
      bar.id = 'fe-find-bar';
      bar.innerHTML = '<span class="feq"></span><span class="fec"></span>' +
        '<button type="button" data-d="-1" aria-label="Previous match">\u2039</button>' +
        '<button type="button" data-d="1" aria-label="Next match">\u203a</button>' +
        '<button type="button" data-x="1" aria-label="Clear highlights">\u2715</button>';
      bar.addEventListener('click', function(e){
        var b = e.target.closest ? e.target.closest('button') : null;
        if(!b) return;
        if(b.getAttribute('data-x')) closeBar();
        else goTo(cur + (+b.getAttribute('data-d')));
      });
      document.body.appendChild(bar);
    }
    bar.querySelector('.feq').textContent = q;
  }
  function syncBar(){
    if(bar) bar.querySelector('.fec').textContent =
      hits.length ? (cur + 1) + '/' + hits.length : '0/0';
  }

  /* a hit can sit inside a filtered-out card, a collapsed card, or a hidden
     quiz answer -- all of which have zero height and cannot be scrolled to */
  function reveal(el){
    if(!el || !el.closest) return;
    var card = el.closest('.qcard');
    if(card){
      card.classList.remove('hide');
      if(!card.classList.contains('open')){
        card.classList.add('open');
        var h = card.querySelector('.qhead');
        if(h) h.setAttribute('aria-expanded', 'true');
      }
    }
    var ans = el.closest('.answer');
    if(ans && !ans.classList.contains('show')){
      ans.classList.add('show');
      var host = ans.closest('[data-quiz]');
      var btn = host && host.querySelector('.reveal-btn');
      if(btn) btn.textContent = 'Hide answer';
    }
  }
  function goTo(n, landing){
    if(!hits.length){ syncBar(); return; }
    if(cur >= 0 && hits[cur]) hits[cur].classList.remove('cur');
    cur = ((n % hits.length) + hits.length) % hits.length;
    hits[cur].classList.add('cur');
    reveal(hits[cur]);
    if(landing) land(hits[cur]); else into(hits[cur], true);
    syncBar();
  }

  function handleGoto(msg){
    closeBar();

    var target = null;
    if(msg.kind === 'qa'){
      /* .qcard.hide is display:none -- drop the topic filter through the guide's
         own chip handler so its count/label stay consistent */
      var all = document.querySelector('.fchip[data-f="all"]');
      if(all && !all.classList.contains('on')) all.click();
      target = document.querySelectorAll('.qcard')[msg.qi] || null;
      reveal(target);
    } else {
      var list = blocks();
      target = list[msg.ord] || null;
      /* ord assumes the guide DOM is static outside #bank; if a guide ever changes
         that, fall back to matching the block's text instead of scrolling somewhere wrong */
      if(msg.probe && !(target && norm(target.textContent).indexOf(msg.probe) === 0)){
        for(var k = 0; k < list.length; k++){
          if(norm(list[k].textContent).indexOf(msg.probe) === 0){ target = list[k]; break; }
        }
      }
    }
    if(!target && msg.secId) target = document.getElementById(msg.secId);

    var terms = (msg.terms && msg.terms.length) ? msg.terms : (msg.query ? [msg.query] : []);
    if(terms.length){
      highlight(terms);
      ensureBar(msg.query || terms.join(' '));
    }

    if(terms.length && hits.length){
      var idx = 0;
      if(target){
        for(var i=0;i<hits.length;i++){
          if(target.contains(hits[i]) ||
             (target.compareDocumentPosition(hits[i]) & Node.DOCUMENT_POSITION_FOLLOWING)){
            idx = i; break;
          }
        }
      }
      goTo(idx, true);
    } else {
      land(target);
      syncBar();
    }
  }

  window.addEventListener('message', function(e){
    if(e.source !== parent) return;
    var d = e.data;
    if(!d || typeof d !== 'object') return;
    if(d.fePrep === 'goto') handleGoto(d);
    else if(d.fePrep === 'clearfind') closeBar();
  });

  window.addEventListener('keydown', function(e){
    if(!bar) return;
    if(e.key === 'Escape') closeBar();
    else if(e.key === 'F3' || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'g')){
      e.preventDefault();
      goTo(cur + (e.shiftKey ? -1 : 1));
    }
  });

  function ping(){ try{ parent.postMessage({fePrep:'ready'}, '*'); }catch(e){} }
  if(document.readyState !== 'loading') ping();
  else document.addEventListener('DOMContentLoaded', ping);
  window.addEventListener('load', ping);
})();
</script>
  </template>

<script>
const GUIDES = [{"key": "jscore", "label": "JS Core", "group": "JavaScript", "kw": "closure this prototype inheritance coercion equality hoisting scope falsy", "b64": ""}, {"key": "eventloop", "label": "Event Loop", "group": "JavaScript", "kw": "call stack microtask macrotask queue settimeout starvation requestanimationframe node nexttick setimmediate async", "b64": ""}, {"key": "promises", "label": "Promises", "group": "JavaScript", "kw": "then catch finally all allsettled race any async await microtask retry backoff abortcontroller unhandled rejection concurrency", "b64": ""}, {"key": "render", "label": "React Rendering", "group": "React", "kw": "virtual dom fiber lanes reconciliation diffing keys memo usememo usecallback batching strictmode uselayouteffect commit error boundary lazy suspense", "b64": ""}, {"key": "hooks", "label": "React Hooks", "group": "React", "kw": "useeffect useref usereducer usestate custom hooks rules dependencies stale closure class component lifecycle componentdidmount react 19 useactionstate useoptimistic useformstatus use usesyncexternalstore useid forwardref useimperativehandle refs actions", "b64": ""}, {"key": "arch", "label": "Component Arch", "group": "React", "kw": "composition context prop drilling redux toolkit zustand jotai selectors reselect immer server state react native compound components render props hoc boundaries", "b64": ""}, {"key": "ssr", "label": "SSR & Hydration", "group": "React", "kw": "server side rendering hydration mismatch csr ssg isr streaming selective suspense rsc server components use client actions next.js prerender ttfb", "b64": ""}, {"key": "perf", "label": "Performance", "group": "Platform", "kw": "core web vitals lcp inp cls fid critical rendering path reflow repaint layout thrashing lazy loading bundle size profiling lighthouse rum", "b64": ""}, {"key": "ts", "label": "TypeScript", "group": "Platform", "kw": "types generics unions intersections narrowing type guards utility types mapped conditional discriminated typescript structural erasure", "b64": ""}, {"key": "data", "label": "Data & Async", "group": "Platform", "kw": "fetching race condition abortcontroller cancellation optimistic update websocket loading error states polling swr query cache", "b64": ""}, {"key": "security", "label": "Browser & Sec", "group": "Platform", "kw": "xss csrf cookies samesite storage localstorage sessionstorage tokens event delegation bubbling capturing dom rendering pixels csp oauth pkce code verifier challenge s256 authorization code flow implicit state nonce oidc refresh token rotation bff redirect uri", "b64": ""}, {"key": "css", "label": "CSS & Layout", "group": "Platform", "kw": "box model border-box margin collapse flexbox grid position sticky stacking context z-index specificity cascade inheritance centering transition animation keyframes custom properties variables will-change flip", "b64": ""}, {"key": "responsive", "label": "Responsive", "group": "Platform", "kw": "media query breakpoint mobile first viewport meta device pixel ratio srcset sizes picture art direction container query clamp minmax auto-fit svh lvh dvh tap target safe area logical properties zoom reflow", "b64": ""}, {"key": "http", "label": "HTTP Protocol", "group": "Platform", "kw": "cache-control etag last-modified revalidation status codes redirect headers content negotiation cors preflight cookies samesite https tls hsts dns preconnect dns-prefetch http1 http2 http3 quic multiplexing websocket sse polling", "b64": ""}, {"key": "seo", "label": "SEO", "group": "Platform", "kw": "crawling indexing robots.txt noindex canonical sitemap redirect soft 404 javascript rendering googlebot dynamic rendering meta description title structured data json-ld schema rich results hreflang x-default core web vitals search console lighthouse crawl budget", "b64": ""}, {"key": "i18n", "label": "i18n / L10n", "group": "Platform", "kw": "internationalisation localisation intl numberformat datetimeformat pluralrules collator locale negotiation bcp47 icu messageformat rtl bidi logical properties timezone utc currency money rounding", "b64": ""}, {"key": "bundlers", "label": "Bundlers", "group": "Platform", "kw": "webpack vite rollup esbuild turbopack loaders plugins tree shaking side effects code splitting chunks hashing hmr dev server source maps module federation bundle analysis", "b64": ""}, {"key": "pwa", "label": "PWA & Workers", "group": "Platform", "kw": "service worker lifecycle install activate waiting skipwaiting clients claim cache api strategies stale while revalidate offline fallback background sync navigation preload manifest maskable icons installability beforeinstallprompt push notifications vapid indexeddb workbox killswitch", "b64": ""}, {"key": "testing", "label": "Testing", "group": "Platform", "kw": "unit integration e2e jest vitest jsdom react testing library queries userevent act msw mock service worker playwright cypress spies stubs fake timers coverage flakiness visual regression snapshot ci", "b64": ""}, {"key": "release", "label": "Release & A/B", "group": "Platform", "kw": "deploy versus release immutable assets atomic deploy chunkloaderror canary blue green progressive rollout rollback feature flag kill switch ab testing bucketing randomisation mde significance peeking srm sample ratio mismatch flicker exposure novelty holdout guardrail source maps", "b64": ""}, {"key": "vibe", "label": "AI Agents", "group": "Meta", "kw": "ai agents claude code hooks skills defense in depth deterministic control", "b64": ""}];
const railEl     = document.getElementById('rail');
const tabsEl     = document.getElementById('tabs');
const stage      = document.getElementById('stage');
const loading    = document.getElementById('loading');
const railToggle = document.getElementById('railToggle');
const backdrop   = document.getElementById('backdrop');
const palette    = document.getElementById('palette');
const pInput     = document.getElementById('paletteInput');
const pList      = document.getElementById('paletteList');
const frames = [];
let active = -1;

const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

// UTF-8 safe base64 decode
function decodeB64(b64){
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++) bytes[i]=bin.charCodeAt(i);
  return new TextDecoder('utf-8').decode(bytes);
}

/* ---------------- full-text index ---------------- */
/* MUST stay byte-identical to SEL in the #fe-receiver script, or `ord` misaligns */
const BLOCK_SEL = 'h2, h3, p, li, td, pre, blockquote';
const RECEIVER  = document.getElementById('fe-receiver').innerHTML;
const escRe = s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const norm  = s => (s || '').replace(/\s+/g, ' ').trim();

let INDEX = null, indexing = null;

function indexGuide(gi){
  const g = GUIDES[gi], out = [];
  let src, doc;
  try{ src = decodeB64(g.b64); }catch(e){ return out; }
  try{ doc = new DOMParser().parseFromString(src, 'text/html'); }catch(e){ return out; }

  /* #bank is empty here but full of .qcards in the live frame -- excluding it in
     both places is what keeps `ord` aligned. Its Q&A is indexed separately below. */
  const root = doc.querySelector('main') || doc.body;
  if(root){
    const nodes = [...root.querySelectorAll(BLOCK_SEL)].filter(el => !el.closest('#bank'));
    let title = g.label, secId = '';
    nodes.forEach((el, ord) => {
      if(el.tagName === 'H2' || el.tagName === 'H3'){
        title = norm(el.textContent) || title;
        const sec = el.closest('section[id]');
        if(sec) secId = sec.id;
      }
      if(el.querySelector(BLOCK_SEL)) return;   // wrapper, not a leaf block
      const text = norm(el.textContent);
      if(text.length < 3) return;
      out.push({gi, kind:'block', ord, secId, title, text, low:text.toLowerCase()});
    });
  }

  const qa = extractQA(src);
  if(qa){
    qa.forEach((row, qi) => {
      if(!Array.isArray(row) || row.length < 4) return;
      const ques = norm(row[2]), ans = norm(row[3]);
      const text = ques + ' — ' + ans;          // matched over both halves
      out.push({gi, kind:'qa', qi, secId:'bank',
                title: ques || norm(row[1]) || 'Q&A',   // headline = the question
                topic: norm(row[1]), snip: ans,
                text, low:text.toLowerCase()});
    });
  }
  return out;
}

/* Bracket-balanced, string-aware scan of `const QA = [...]`. A lazy regex is not
   enough: an answer containing "T[];" terminates it early (the TypeScript guide). */
function extractQA(src){
  const k = src.indexOf('const QA');
  if(k < 0) return null;
  const open = src.indexOf('[', k);
  if(open < 0) return null;
  let depth = 0, inStr = false, escaped = false;
  for(let i = open; i < src.length; i++){
    const c = src[i];
    if(inStr){
      if(escaped) escaped = false;
      else if(c === '\\') escaped = true;
      else if(c === '"') inStr = false;
      continue;
    }
    if(c === '"') inStr = true;
    else if(c === '[') depth++;
    else if(c === ']' && --depth === 0){
      try{
        const arr = JSON.parse(src.slice(open, i + 1));
        return Array.isArray(arr) ? arr : null;
      }catch(e){ return null; }
    }
  }
  return null;
}

/* ~1.1MB to decode+parse; sliced across idle callbacks so boot stays snappy */
function buildIndex(){
  if(INDEX) return Promise.resolve(INDEX);
  if(indexing) return indexing;
  const idle = window.requestIdleCallback || (fn => setTimeout(fn, 1));
  indexing = new Promise(resolve => {
    const acc = [];
    let gi = 0;
    (function step(){
      const t0 = performance.now();
      while(gi < GUIDES.length && performance.now() - t0 < 26) acc.push(...indexGuide(gi++));
      if(gi < GUIDES.length) idle(step);
      else { INDEX = acc; resolve(INDEX); }
    })();
  });
  return indexing;
}

function searchIndex(phrase, terms){
  const hits = [];
  for(const rec of INDEX){
    const tl = rec.title.toLowerCase();
    let ok = true;
    for(const t of terms){ if(rec.low.indexOf(t) < 0 && tl.indexOf(t) < 0){ ok = false; break; } }
    if(!ok) continue;
    let s = 0;
    if(tl.indexOf(phrase) >= 0) s += 100;
    const at = rec.low.indexOf(phrase);
    if(at >= 0){
      s += 40;
      if(new RegExp('\\b' + escRe(phrase)).test(rec.low)) s += 25;
      s += Math.max(0, 15 - at / 50);
    }
    if(rec.kind === 'qa') s += 10;
    s -= Math.min(10, rec.text.length / 400);   // prefer tight blocks over walls of text
    hits.push({rec, s});
  }
  hits.sort((a, b) => b.s - a.s || a.rec.gi - b.rec.gi || a.rec.ord - b.rec.ord);
  return hits;
}

/* escape first, then wrap terms -- one combined regex so marks never nest */
function markTerms(html, terms){
  if(!terms.length) return html;
  const re = new RegExp('(' + terms.slice().sort((a,b) => b.length - a.length)
    .map(escRe).join('|') + ')', 'gi');
  return html.replace(re, '<b>$1</b>');
}
function snippet(text, phrase, terms){
  const low = text.toLowerCase();
  let at = low.indexOf(phrase);
  if(at < 0) for(const t of terms){ at = low.indexOf(t); if(at >= 0) break; }
  if(at < 0) at = 0;
  let start = Math.max(0, at - 48);
  if(start > 0){
    const sp = text.indexOf(' ', start);
    if(sp > 0 && sp < start + 16) start = sp + 1;
  }
  return (start > 0 ? '…' : '') + esc(text.slice(start, start + 155)) +
         (start + 155 < text.length ? '…' : '');
}

/* ---------------- rail ---------------- */
const tabEls = [];
let lastGroup = null;
GUIDES.forEach((g,i)=>{
  if(g.group && g.group !== lastGroup){
    const gl=document.createElement('div');
    gl.className='grp-label';
    gl.textContent=g.group;
    tabsEl.appendChild(gl);
    lastGroup = g.group;
  }
  const num = String(i+1).padStart(2,'0');
  const tab = document.createElement('button');
  tab.className='rail-item';
  tab.setAttribute('role','tab');
  tab.setAttribute('aria-selected','false');
  tab.title = g.label;
  tab.innerHTML = `<span class="n">${num}</span><span class="lbl">${esc(g.label)}</span>`;
  tab.addEventListener('click',()=>{ show(i); closeDrawer(); });
  tabsEl.appendChild(tab);
  tabEls.push(tab);

  const f = document.createElement('iframe');
  f.title = g.label;
  f.loading = 'lazy';
  frames.push({el:f, loaded:false, ready:false, pending:null, g});
  stage.appendChild(f);
});

function show(i){
  if(i===active) return;
  const fr = frames[i];
  if(!fr.loaded){
    const html = decodeB64(fr.g.b64);
    const cut  = html.lastIndexOf('</body>');
    fr.el.srcdoc = cut < 0 ? html + RECEIVER
                           : html.slice(0, cut) + RECEIVER + html.slice(cut);
    fr.loaded = true;
  }
  frames.forEach((f,j)=>f.el.classList.toggle('on', j===i));
  tabEls.forEach((t,j)=>{
    const on = j===i;
    t.classList.toggle('on', on);
    t.setAttribute('aria-selected', on ? 'true' : 'false');
  });
  if(tabEls[i].scrollIntoView) tabEls[i].scrollIntoView({block:'nearest'});
  active = i;
  loading.style.display='none';
  try{ localStorage.setItem('fe-prep-tab', String(i)); }catch(e){}
}

/* ---------------- collapse ---------------- */
function setCollapsed(v){
  railEl.classList.toggle('collapsed', v);
  railToggle.textContent = v ? '›' : '‹';
  railToggle.setAttribute('aria-label', v ? 'Expand topic list' : 'Collapse topic list');
  try{ localStorage.setItem('fe-prep-rail', v ? '1' : '0'); }catch(e){}
}
let startCollapsed = window.innerWidth <= 1100;
try{
  const s = localStorage.getItem('fe-prep-rail');
  if(s !== null) startCollapsed = (s === '1');
}catch(e){}
setCollapsed(startCollapsed);
railToggle.addEventListener('click',()=>setCollapsed(!railEl.classList.contains('collapsed')));

/* ---------------- mobile drawer ---------------- */
function openDrawer(){ railEl.classList.add('open'); backdrop.classList.add('open'); }
function closeDrawer(){ railEl.classList.remove('open'); backdrop.classList.remove('open'); }
document.getElementById('railBtn').addEventListener('click',openDrawer);
backdrop.addEventListener('click',closeDrawer);

/* ---------------- jump palette ---------------- */
let results = [], sel = 0, lastQuery = '';
const MAX_HITS = 60;

function renderPalette(q){
  lastQuery = q.trim();
  const needle = lastQuery.toLowerCase();
  const terms  = needle.split(/\s+/).filter(Boolean);
  results = [];
  let html = '', waiting = false;

  const topics = GUIDES.map((g,i)=>({g,i})).filter(({g})=>
    !needle || (g.label+' '+g.group+' '+(g.kw||'')).toLowerCase().includes(needle));
  if(topics.length){
    if(needle) html += '<li class="pgroup">Topics</li>';
    topics.forEach(({g,i})=>{
      const n = results.length;
      results.push({kind:'topic', i});
      html += `<li class="pitem${n===0?' sel':''}" data-n="${n}">`+
        `<span class="pn">${String(i+1).padStart(2,'0')}</span>`+
        `<span class="ptitle">${esc(g.label)}</span><span class="pg">${esc(g.group)}</span></li>`;
    });
  }

  if(needle){
    if(!INDEX){
      waiting = true;
      html += '<li class="pgroup">In guides</li><li class="pempty">indexing…</li>';
      buildIndex().then(()=>{
        if(!palette.hidden && pInput.value.trim().toLowerCase() === needle) renderPalette(pInput.value);
      });
    } else {
      const hits = searchIndex(needle, terms);
      if(hits.length){
        html += `<li class="pgroup">${hits.length} match${hits.length===1?'':'es'} in guides`+
                `${hits.length>MAX_HITS?` · showing first ${MAX_HITS}`:''}</li>`;
        hits.slice(0, MAX_HITS).forEach(({rec})=>{
          const n = results.length;
          results.push({kind:'hit', rec});
          const snipSrc = rec.snip || rec.text;
          const bare = snipSrc === rec.title;    // a heading: snippet would just echo the title
          const tag = rec.kind === 'qa'
            ? 'Q&amp;A' + (rec.topic ? ' · ' + esc(rec.topic) : '')
            : esc(GUIDES[rec.gi].label);
          const row = `<span class="prow"><span class="pn">${String(rec.gi+1).padStart(2,'0')}</span>`+
            `<span class="ptitle">${markTerms(esc(rec.title), terms)}</span>`+
            `<span class="pg">${tag}</span></span>`;
          html += `<li class="pitem${bare?'':' two'}${n===0?' sel':''}" data-n="${n}">`+ row +
            (bare ? '' : `<span class="psnip">${markTerms(snippet(snipSrc, needle, terms), terms)}</span>`)+
            `</li>`;
        });
      }
    }
  }

  sel = 0;
  pList.innerHTML = (results.length || waiting) ? html
    : '<li class="pempty">Nothing in the guides matches that.</li>';
}
function openPalette(){
  if(!palette.hidden) return;
  palette.hidden = false;
  pInput.value = '';
  renderPalette('');
  pInput.focus();
}
function closePalette(){ palette.hidden = true; }
/* frames answer with {fePrep:'ready'}; a goto fired before that is queued */
function sendToFrame(i, msg){
  const fr = frames[i];
  if(!fr) return;
  if(fr.ready && fr.el.contentWindow) fr.el.contentWindow.postMessage(msg, '*');
  else fr.pending = msg;
}

function choose(n){
  const r = results[n];
  if(!r) return;
  closePalette();
  closeDrawer();

  const gi = r.kind === 'topic' ? r.i : r.rec.gi;
  if(active >= 0 && active !== gi) sendToFrame(active, {fePrep:'clearfind'});
  show(gi);
  if(r.kind === 'hit'){
    sendToFrame(gi, {fePrep:'goto', kind:r.rec.kind, ord:r.rec.ord,
                     qi:r.rec.qi, secId:r.rec.secId, query:lastQuery,
                     terms:lastQuery.toLowerCase().split(/\s+/).filter(Boolean),
                     probe:r.rec.text.slice(0, 60).toLowerCase()});
  }
  const fr = frames[gi];
  if(fr && fr.el && fr.el.focus) fr.el.focus();
}
function moveSel(d){
  if(!results.length) return;
  sel = (sel + d + results.length) % results.length;
  const items = pList.querySelectorAll('.pitem');
  items.forEach((el,n)=>el.classList.toggle('sel', n===sel));
  if(items[sel] && items[sel].scrollIntoView) items[sel].scrollIntoView({block:'nearest'});
}
pInput.addEventListener('input',()=>renderPalette(pInput.value));
pInput.addEventListener('keydown',e=>{
  if(e.key==='ArrowDown'){ e.preventDefault(); moveSel(1); }
  else if(e.key==='ArrowUp'){ e.preventDefault(); moveSel(-1); }
  else if(e.key==='Enter'){ e.preventDefault(); choose(sel); }
  else if(e.key==='Escape'){ e.preventDefault(); closePalette(); }
});
pList.addEventListener('click',e=>{
  const li = e.target.closest ? e.target.closest('.pitem') : null;
  if(li) choose(+li.dataset.n);
});
palette.addEventListener('mousedown',e=>{ if(e.target===palette) closePalette(); });
document.getElementById('jumpBtn').addEventListener('click',openPalette);

/* ---------------- keyboard ---------------- */
window.addEventListener('keydown',e=>{
  const tag = (e.target && e.target.tagName) || '';
  if((e.metaKey||e.ctrlKey) && e.key.toLowerCase()==='k'){ e.preventDefault(); openPalette(); return; }
  if(!palette.hidden) return;                       // the palette input owns its keys
  if(/^(INPUT|TEXTAREA)$/.test(tag)) return;
  if(e.key==='/'){ e.preventDefault(); openPalette(); return; }
  if(/iframe/i.test(tag)) return;                   // let the guide handle its own
  if(/^[1-9]$/.test(e.key) && +e.key<=GUIDES.length){ show(+e.key-1); }
  else if(e.key==='ArrowRight'){ show((active+1)%GUIDES.length); }
  else if(e.key==='ArrowLeft'){ show((active-1+GUIDES.length)%GUIDES.length); }
});

// guides forward ⌘K / Esc up, since keys inside an iframe never reach us
window.addEventListener('message',e=>{
  const d = e.data;
  if(!d || typeof d !== 'object') return;
  if(d.fePrep === 'ready'){
    const fr = frames.find(f => f.el.contentWindow === e.source);
    if(fr && !fr.ready){
      fr.ready = true;
      if(fr.pending){ e.source.postMessage(fr.pending, '*'); fr.pending = null; }
    }
  }
  else if(d.fePrep === 'palette') openPalette();
  else if(d.fePrep === 'close'){ closePalette(); closeDrawer(); }
});

if(!/Mac|iPhone|iPad/i.test(navigator.platform || navigator.userAgent || '')){
  document.getElementById('kbdHint').textContent = 'Ctrl K';
}

/* ---------------- restore last tab ---------------- */
let start = 0;
try{ const s = localStorage.getItem('fe-prep-tab'); if(s!==null && +s<GUIDES.length) start=+s; }catch(e){}
show(start);
buildIndex();   // warm in idle time so the first ⌘K is instant
</script>
</body>
</html>
